# Database Configuration
# PostgreSQL with pgvector extension for semantic search

# Database connection details
DB_HOST=localhost
DB_PORT=5434
DB_NAME=oilfield
DB_USER=oilfield
DB_PASSWORD=oilfield_dev

# Connection URL format
DATABASE_URL=postgresql://oilfield:oilfield_dev@localhost:5434/oilfield

# Notes:
# - Port 5434 is used to avoid conflicts with other PostgreSQL instances
# - Container name: oilfield-postgres
# - Extensions enabled: pgvector, PostGIS
# - Data persisted in Docker volume: postgres_data
# - To connect from host: psql -h localhost -p 5434 -U oilfield -d oilfield

# API Configuration (add your API keys here)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
